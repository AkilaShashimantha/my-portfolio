generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 1. SiteProfile (Singleton model for Brief Portfolio Explanation / Bio)
model SiteProfile {
  id               String   @id @default(cuid())
  fullName         String
  headline         String
  subheadline      String
  shortBio         String   @db.Text
  extendedBio      String   @db.Text
  avatarUrl        String
  resumeUrl        String
  location         String
  availableForWork Boolean  @default(true)
  updatedAt        DateTime @updatedAt
}

// 2. SocialLink (CRUD for Social Media Contacts)
model SocialLink {
  id        String   @id @default(cuid())
  platform  String
  url       String
  handle    String
  iconName  String
  order     Int      @default(0)
  isVisible Boolean  @default(true)
}

// 3. Photo (CRUD for "My Photos" Gallery)
model Photo {
  id          String   @id @default(cuid())
  title       String
  caption     String   @db.Text
  imageUrl    String
  location    String
  takenAt     DateTime @default(now())
  aspectRatio String   @default("LANDSCAPE") // PORTRAIT | LANDSCAPE | SQUARE
  featured    Boolean  @default(false)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
}

// 4. Project (CRUD for "My Projects")
model Project {
  id            String   @id @default(cuid())
  title         String
  slug          String   @unique
  summary       String   @db.Text
  description   String   @db.Text
  coverImage    String
  galleryImages String[]
  techStack     String[]
  liveUrl       String?
  repoUrl       String?
  year          String
  featured      Boolean  @default(false)
  order         Int      @default(0)
  createdAt     DateTime @default(now())
}

// 5. WorkExperience (CRUD for "Work Experience")
model WorkExperience {
  id             String   @id @default(cuid())
  role           String
  company        String
  companyUrl     String?
  location       String
  employmentType String   @default("Full-time")
  startDate      String
  endDate        String?
  isCurrent      Boolean  @default(false)
  description    String   @db.Text
  highlights     String[]
  technologies   String[]
  order          Int      @default(0)
}

// 6. Certificate (CRUD for "Certificates")
model Certificate {
  id            String   @id @default(cuid())
  title         String
  issuer        String
  issueDate     String
  expiryDate    String?
  credentialId  String?
  credentialUrl String?
  imageUrl      String
  order         Int      @default(0)
}

// 7. ContactSubmission (CRUD for Contact Form Inbox)
model ContactSubmission {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String   @db.Text
  status    String   @default("UNREAD") // UNREAD | READ | ARCHIVED
  createdAt DateTime @default(now())
}

// NextAuth Models (NextAuth v5 schema support)
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          String    @default("ADMIN")
  accounts      Account[]
  sessions      Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
